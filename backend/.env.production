# ── Chesstong Production Configuration ──
# Copy this file to .env on the production host and adjust secrets as needed.

PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# ── AI Provider (Ollama) ──
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
AI_TIMEOUT_MS=20000

# ── Stockfish Engine (local binary) ──
STOCKFISH_BIN=/usr/local/bin/stockfish
STOCKFISH_TIMEOUT_MS=3500

# ── Engine service URL (optional, fallback) ──
STOCKFISH_SERVICE_URL=http://engine:8081
ENGINE_TIMEOUT_MS=3000
# ⚠️ IMPORTANT: Set a strong random code for SMS verification.
# Generate with: openssl rand -hex 16
DEMO_LOGIN_CODE=

# ── Domain ──
DOMAIN=chesstong.com
