PORT=8080
HOST=0.0.0.0
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
AI_TIMEOUT_MS=20000
# ── Text-to-Speech (阿里云 CosyVoice，角色音色朗读) ──────────────
# 复用通义千问的 Key：若未单独配置 DASHSCOPE_API_KEY，会回退到 QWEN_API_KEY。
DASHSCOPE_API_KEY=
TTS_PROVIDER=dashscope
# TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
STOCKFISH_SERVICE_URL=http://localhost:8081
ENGINE_TIMEOUT_MS=3000
# SMS verification code (set to a random value for local development)
DEMO_LOGIN_CODE=123456
# Optional. If omitted, the backend searches ../tools/stockfish/stockfish automatically.
# STOCKFISH_BIN=../tools/stockfish/stockfish/src/stockfish
STOCKFISH_TIMEOUT_MS=3500
